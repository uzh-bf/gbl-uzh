# Committed starter-mode environment — safe, dev-only values, NO real secrets.
# Loaded by the starter compose `app` service and re-sourced by the lifecycle
# scripts via GBL_ENV_FILE. Unlike the devrouter config, everything runs on
# plain http over ports published to 127.0.0.1 — no host tooling needed.

# Tells the shared lifecycle scripts to skip the devrouter URL rewrite.
GBL_DEV_MODE=starter
GBL_GAME_TARGET=demo

# --- Database (postgres service, fixed dev creds) ---
DATABASE_URL=postgres://prisma:prisma@postgres:5432/prisma?schema=public
SHADOW_DATABASE_URL=postgres://prisma:prisma@postgres:5432/shadow?schema=public

# --- NextAuth ---
NEXTAUTH_SECRET=local-dev-not-a-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# --- Public, browser-facing URLs (published on 127.0.0.1) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/graphql

# --- File watching over bind mounts (Windows/macOS hosts) ---
# Host file saves do not generate inotify events inside the container, so
# webpack/tsx watchers never fire and "hot reload" silently does nothing.
# Polling watchers trade a little CPU for a working edit-refresh loop.
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# --- Local OIDC (mock-oauth2-server sidecar, replaces Auth0) ---
# The mock shares the app container's network namespace and port 8090 is
# published to the host, so http://localhost:8090 is the SAME address for the
# browser (authorize) and the app server (discovery/token/jwks) — the token
# `iss` matches without TLS or extra host mappings.
AUTH0_ISSUER=http://localhost:8090/default
AUTH0_CLIENT_ID=demo-game-local
AUTH0_CLIENT_SECRET=demo-game-local-secret
