{
  "name": "@gbl-uzh/website",
  "version": "0.4.51",
  "license": "AGPL-3.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@socialgouv/matomo-next": "1.8.0",
    "@uzh-bf/design-system": "4.1.6",
    "gray-matter": "4.0.3",
    "next": "16.2.12",
    "next-mdx-remote": "6.0.0",
    "ramda": "0.30.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "8.0.7",
    "recharts": "2.15.4",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "~4.1.11",
    "@tailwindcss/typography": "~0.5.20",
    "@types/node": "^20.17.6",
    "@types/ramda": "^0.30.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "~7.0.3",
    "eslint": "~9.39.4",
    "eslint-config-next": "~16.2.12",
    "npm-run-all": "~4.1.5",
    "postcss": "~8.4.49",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remark-wiki-link": "2.0.1",
    "sharp": "~0.32.6",
    "tailwindcss": "~4.1.11",
    "tw-animate-css": "~1.3.4",
    "typescript": "6.0.2"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production next build --webpack",
    "check": "npm-run-all --parallel check:ts format:ci lint",
    "check:fix": "npm-run-all check:ts format lint:fix",
    "check:ts": "../../node_modules/typescript-native/bin/tsc --project tsconfig.json",
    "check:ts:typescript6": "node_modules/typescript/bin/tsc --project tsconfig.json",
    "dev-web": "cross-env NODE_ENV=development next dev --webpack -p 3002",
    "export": "npm run build && mkdir out/advisor && cp '../advisor/Gamification Advisor.html' out/advisor/ && cp '../advisor/advisor_out.css' out/advisor/ && cp -R ../quartz/public out/quartz",
    "format": "prettier --write \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.(js|ts)\"",
    "format:ci": "prettier --list-different \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.(js|ts)\"",
    "lint": "eslint --ext .js,.ts,.tsx src/",
    "lint:fix": "eslint --fix --ext .js,.ts,.tsx src/",
    "optimize": "node export/resizeImages.js",
    "optimize:clean": "node export/cleanup.js",
    "start": "next start"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
