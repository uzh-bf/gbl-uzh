{
  "name": "@gbl-uzh/website",
  "version": "0.4.32",
  "license": "AGPL-3.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@socialgouv/matomo-next": "1.8.0",
    "@tailwindcss/aspect-ratio": "~0.4.2",
    "@tailwindcss/forms": "~0.5.10",
    "@tailwindcss/postcss": "~4.1.11",
    "@tailwindcss/typography": "~0.5.16",
    "@uzh-bf/design-system": "4.1.4",
    "autoprefixer": "~10.4.20",
    "gray-matter": "~4.0.3",
    "next": "16.0.0",
    "next-mdx-remote": "4.4.1",
    "ramda": "0.30.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "recharts": "2.8.0",
    "tailwind-merge": "2.4.0",
    "tailwindcss": "~4.1.11",
    "tw-animate-css": "~1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ramda": "^0.30.2",
    "@types/react": "^19.2.2",
    "cross-env": "~7.0.3",
    "eslint-config-next": "~16.0.0",
    "npm-run-all": "~4.1.5",
    "postcss": "~8.4.49",
    "prettier": "~3.3.2",
    "prettier-plugin-organize-imports": "~3.2.3",
    "prettier-plugin-tailwindcss": "~0.4.1",
    "remark-wiki-link": "~1.0.4",
    "sharp": "~0.32.6",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production next build",
    "check": "npm-run-all --parallel check:ts format:ci lint",
    "check:fix": "npm-run-all check:ts format lint:fix",
    "check:ts": "tsc",
    "dev-web": "cross-env NODE_ENV=development next -p 3002",
    "export": "npm run build && mkdir out/advisor && cp '../advisor/Gamification Advisor.html' out/advisor/ && cp '../advisor/advisor_out.css' out/advisor/ && cp -R ../quartz/public out/quartz",
    "format": "prettier --write \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.(js|ts)\"",
    "format:ci": "prettier --list-different \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.(js|ts)\"",
    "lint": "eslint --ext .js,.ts,.tsx src/",
    "lint:fix": "eslint --fix --ext .js,.ts,.tsx src/",
    "optimize": "node export/resizeImages.js",
    "optimize:clean": "node export/cleanup.js",
    "start": "next start"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
