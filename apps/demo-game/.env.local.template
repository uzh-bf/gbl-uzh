# OPTIONAL, host mode (`pnpm dev` on your machine) only: log in against a real
# Auth0 tenant instead of the mock OIDC service. By default no .env.local is
# needed — host mode uses the committed dev-only values from .env.development.
# In the devcontainer modes this file has NO effect: the container environment
# (devcontainer.env / starter.env) wins over every .env* file.
#
# IMPORTANT: .env.local wins over .env.development, and a key left EMPTY here
# still shadows the working default — delete any line you do not fill in.

# generate using `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Auth0 application settings for manual local setup without the
# mocked OIDC service.
# Application login URL: http://localhost:3000/admin/login
# Allowed callback URL: http://localhost:3000/api/auth/callback/auth0
# Allowed logout URL: http://localhost:3000/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://
