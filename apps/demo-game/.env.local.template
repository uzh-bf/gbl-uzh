# OPTIONAL: log in against a real Auth0 tenant instead of the mock OIDC service.
# By default no .env.local is needed — local development uses the committed
# mock values from .env.development. Container process variables override this
# file, so real Auth0 opt-in is supported in native host mode only.
# Set GBL_AUTH_MODE=auth0 explicitly; without it, stale AUTH0_* values are
# ignored and the local mock remains active.
#
# IMPORTANT: .env.local wins over .env.development, and a key left EMPTY here
# still shadows the working default — delete any line you do not fill in.

# generate using `openssl rand -base64 32`
NEXTAUTH_SECRET=

GBL_AUTH_MODE=auth0

# Auth0 application settings for manual local setup without the
# mocked OIDC service.
# Native callback: http://localhost:3000/api/auth/callback/auth0
# Match the login/logout URLs to the same origin.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://
