    "@graphql-codegen/typed-document-node": "~5.0.15",
    "@graphql-codegen/typescript": "~4.1.6",
    "@graphql-codegen/typescript-operations": "~4.3.1",
    "@graphql-codegen/typescript-resolvers": "~4.4.4",
    "@tailwindcss/typography": "0.5.10",
