    "autoprefixer": "~10.4.21",
    "cross-env": "~7.0.3",
    "eslint": "~8.57.1",
    "eslint-config-next": "~15.0.4",
    "jest": "~29.7.0",
    "npm-run-all": "~4.1.5",
    "postcss": "~8.4.49",
    "postcss-import": "~16.1.0",
    "prettier": "~2.8.8",
    "prettier-plugin-organize-imports": "~4.1.0",
    "prettier-plugin-tailwindcss": "~0.4.1",
    "tailwindcss": "~3.4.17",
    "tailwindcss-animate": "~1.0.7",
    "tailwindcss-radix": "~3.0.5",
    "ts-jest": "~29.2.6",
    "tsx": "~4.19.3",
    "typescript": "~5.6.3"
