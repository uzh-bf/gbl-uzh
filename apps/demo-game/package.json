  "scripts": {
    "build": "run-s prisma:copy prisma:generate build:next",
    "build:next": "cross-env NODE_ENV=production next build --webpack",
    "check": "npm-run-all --parallel check:ts format:ci lint",
    "check:fix": "npm-run-all check:ts format lint:fix",
    "check:ts": "tsc",
    "dev": "run-s prisma:copy prisma:generate dev:exec",
    "dev:doppler": "infisical run --env=dev -- pnpm run dev",
    "dev:exec": "run-p dev:next",
    "dev:next": "next dev --webpack",
    "format": "prettier --write \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.js\" \"*.ts\"",
    "format:ci": "prettier --list-different \"src/**/*.(js|ts|tsx|graphql|json)\" \"*.js\" \"*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:copy": "tsx prisma/copy.ts",
    "prisma:deploy": "infisical run --env=prd -- prisma migrate deploy --schema=prisma/schema",
    "prisma:generate": "prisma generate --schema=prisma/schema",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema",
    "prisma:push": "prisma db push --schema=prisma/schema",
    "prisma:reset": "prisma migrate reset --schema=prisma/schema",
    "prisma:rollback": "infisical run --env=prd -- prisma migrate resolve --schema=prisma/schema --rolled-back",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:stg": "infisical run --env=stg -- tsx prisma/seed.ts",
    "prisma:setup": "run-s prisma:reset prisma:push prisma:seed",
    "prisma:setup:prd": "infisical run --env=prd -- run-s prisma:reset prisma:push prisma:seed",
    "prisma:setup:stg": "infisical run --env=stg -- run-s prisma:reset prisma:push prisma:seed",
    "prisma:studio": "prisma studio --schema=prisma/schema",
    "prisma:studio:prd": "infisical run --env=prd -- prisma studio --schema=prisma/schema",
    "prisma:studio:stg": "infisical run --env=stg -- prisma studio --schema=prisma/schema",
    "start": "next start",
    "test": "jest",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand --watch",
    "test:watch": "jest --watch"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
