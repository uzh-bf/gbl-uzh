# Defaults for running `pnpm dev` natively on your machine ("host mode"),
# against the dockerized Postgres + OIDC mock from the root docker-compose.yml
# (`docker compose up -d` in the repo root). Both devcontainer configs override
# every value here through the container environment (env_file/post-start.sh),
# which wins over .env* files — Next.js and dotenv never overwrite existing env.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-not-a-secret-change-me

# Local OIDC mock (mock-oauth2-server, replaces Auth0): one-click login as the
# fixed dev admin gbl-dev@df.uzh.ch. To use a real Auth0 tenant instead, copy
# .env.local.template to .env.local — its values override these.
AUTH0_ISSUER=http://localhost:8090/default
AUTH0_CLIENT_ID=demo-game-local
AUTH0_CLIENT_SECRET=demo-game-local-secret
