# generate using `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Native host startup for this example supports an explicit real Auth0 tenant
# only. Mock OIDC startup is unsupported in this package; use the starter or
# devrouter configuration for local mock login.
GBL_AUTH_MODE=auth0

# The committed .env.development pins https://localhost (devrouter) URLs, so a
# native run must point them at the local dev server instead.
# IMPORTANT: .env.local wins over .env.development, and a key left EMPTY here
# still shadows the working default — delete any line you do not fill in.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/graphql

# Auth0 application settings for the native real-tenant setup.
# Application login URL: http://localhost:3000/admin/login
# Allowed callback URL: http://localhost:3000/api/auth/callback/auth0
# Allowed logout URL: http://localhost:3000/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://
