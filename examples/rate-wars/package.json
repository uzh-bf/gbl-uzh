  "scripts": {
    "build": "run-s prisma:copy prisma:generate build:next",
    "build:next": "cross-env NODE_ENV=production next build --webpack",
    "check": "npm-run-all --parallel check:ts format:ci lint",
    "check:fix": "npm-run-all check:ts format lint:fix",
    "check:ts": "../../node_modules/typescript-native/bin/tsc --project tsconfig.json",
    "check:ts:typescript6": "node_modules/typescript/bin/tsc --project tsconfig.json",
    "dev": "run-s prisma:copy prisma:generate dev:exec",
    "dev:doppler": "infisical run --env=dev -- pnpm run dev",
    "dev:exec": "run-p dev:next",
    "dev:next": "next dev --webpack",
    "format": "prettier --write \"src/**/*.(js|ts|tsx|json)\" \"*.js\" \"*.ts\"",
    "format:ci": "prettier --list-different \"src/**/*.(js|ts|tsx|json)\" \"*.js\" \"*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "precheck": "run-s prisma:copy prisma:generate",
    "prisma:copy": "tsx prisma/copy.ts",
    "prisma:deploy": "infisical run --env=prd -- prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma migrate reset",
    "prisma:rollback": "infisical run --env=prd -- prisma migrate resolve --rolled-back",
    "prisma:seed": "prisma db seed",
    "prisma:seed:stg": "infisical run --env=stg -- prisma db seed",
    "prisma:setup": "run-s prisma:reset prisma:push prisma:seed",
    "prisma:setup:prd": "infisical run --env=prd -- run-s prisma:reset prisma:push prisma:seed",
    "prisma:setup:stg": "infisical run --env=stg -- run-s prisma:reset prisma:push prisma:seed",
    "prisma:studio": "prisma studio",
    "prisma:studio:prd": "infisical run --env=prd -- prisma studio",
    "prisma:studio:stg": "infisical run --env=stg -- prisma studio",
    "start": "next start",
    "test": "jest",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand --watch",
    "test:watch": "jest --watch"
  },
  "volta": {
    "extends": "../../package.json"
  }
