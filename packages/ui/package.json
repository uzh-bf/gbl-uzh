{
  "name": "@gbl-uzh/ui",
  "version": "0.4.13",
  "description": "Shared user-interface components for GBL learning games",
  "license": "LGPL-3.0",
  "keywords": [
    "game-based learning",
    "react",
    "education",
    "university"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzh-bf/gbl-uzh.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/uzh-bf/gbl-uzh#readme",
  "bugs": {
    "url": "https://github.com/uzh-bf/gbl-uzh/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "~4.1.11",
    "@types/node": "^24.0.0",
    "@types/ramda": "^0.30.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "~7.15.0",
    "@typescript-eslint/parser": "~7.15.0",
    "@uzh-bf/design-system": "~4.1.6",
    "@vitejs/plugin-react-swc": "~3.7.1",
    "@apollo/client": "3.14.1",
    "eslint": "~8.57.1",
    "eslint-plugin-react-hooks": "~4.6.2",
    "eslint-plugin-react-refresh": "~0.4.7",
    "postcss": "~8.4.49",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "tailwindcss": "~4.1.11",
    "typescript": "6.0.2",
    "vite": "~5.4.11",
    "vite-plugin-dts": "~4.3.0",
    "vite-plugin-externalize-deps": "~0.8.0"
  },
  "peerDependencies": {
    "@apollo/client": "^3.11.10",
    "@uzh-bf/design-system": "^4.1.6",
    "next": "^16.2.9",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.80.0"
  },
  "scripts": {
    "build": "node_modules/typescript/bin/tsc --project tsconfig.json && vite build",
    "check:ts": "../../node_modules/typescript-native/bin/tsc --project tsconfig.json",
    "check:ts:typescript6": "node_modules/typescript/bin/tsc --project tsconfig.json",
    "dev": "vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepack": "pnpm run build",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module",
  "dependencies": {
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tooltip": "1.2.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "lucide-react": "0.522.0",
    "ramda": "0.30.1",
    "react-dice-complete": "2.2.0",
    "react-markdown": "8.0.7",
    "recharts": "2.15.4",
    "tailwind-merge": "3.3.1",
    "yup": "1.6.1"
  }
}
